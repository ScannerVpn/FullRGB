<Window x:Class="FullRGB.StartupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="FullRGB" Height="392" Width="460" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" Background="{StaticResource AppBackdrop}"
        WindowStyle="None" UseLayoutRounding="True"
        FontFamily="Segoe UI Variable Text, Segoe UI">

  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="38" ResizeBorderThickness="0"
                        GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
  </shell:WindowChrome.WindowChrome>

  <Grid Margin="20,16,20,16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- brand -->
    <Grid Grid.Row="0" Margin="0,0,0,18">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <Grid Grid.Column="0" Width="36" Height="36" Margin="0,0,13,0" VerticalAlignment="Center">
        <Ellipse Width="36" Height="36" Stroke="{DynamicResource BrandGrad}" StrokeThickness="4"
                 StrokeDashArray="3.05 1.05" StrokeDashCap="Flat"/>
        <Ellipse Width="9" Height="9" Fill="{StaticResource Text}"/>
      </Grid>
      <StackPanel Grid.Column="1" VerticalAlignment="Center">
        <TextBlock Text="FullRGB" Style="{StaticResource H1}"/>
        <TextBlock x:Name="TitleTxt" Style="{StaticResource MutedTxt}" Margin="0,2,0,0"/>
      </StackPanel>
      <Button x:Name="AbortBtn" Grid.Column="2" Style="{StaticResource CloseBtn}" Content="&#xE8BB;"
              Click="Abort_Click" VerticalAlignment="Top" Margin="0,-8,-10,0"
              shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
    </Grid>

    <!-- current stage + progress -->
    <StackPanel Grid.Row="1" Margin="0,0,0,15">
      <Grid Margin="0,0,0,9">
        <TextBlock x:Name="StageTxt" Style="{StaticResource Txt}" TextWrapping="Wrap"
                   Margin="0,0,44,0"/>
        <TextBlock x:Name="PercentTxt" Style="{StaticResource MutedTxt}"
                   HorizontalAlignment="Right" VerticalAlignment="Top"/>
      </Grid>
      <ProgressBar x:Name="Bar" Style="{StaticResource Prog}" Minimum="0" Maximum="100"/>
      <TextBlock x:Name="BytesTxt" Style="{StaticResource FaintTxt}" Margin="0,7,0,0"/>
    </StackPanel>

    <!-- log -->
    <Border Grid.Row="2" Style="{StaticResource CardBd}" Padding="13,11">
      <ScrollViewer x:Name="LogScroll" VerticalScrollBarVisibility="Auto">
        <StackPanel x:Name="LogPanel"/>
      </ScrollViewer>
    </Border>

    <!-- actions -->
    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
      <Button x:Name="SkipBtn" Style="{StaticResource GhostBtn}" Click="Skip_Click"
              Visibility="Collapsed" Margin="0,0,8,0"/>
      <Button x:Name="ActionBtn" Style="{StaticResource AccentBtn}" Click="Action_Click"
              Visibility="Collapsed"/>
    </StackPanel>
  </Grid>
</Window>
