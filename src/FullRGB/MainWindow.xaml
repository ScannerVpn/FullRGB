<Window x:Class="FullRGB.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="FullRGB" Height="900" Width="1280" MinWidth="1080" MinHeight="720"
        Background="{StaticResource AppBackdrop}" WindowStartupLocation="CenterScreen"
        TextOptions.TextFormattingMode="Ideal" UseLayoutRounding="True" SnapsToDevicePixels="True"
        WindowStyle="None" ResizeMode="CanResize"
        FontFamily="Segoe UI Variable Text, Segoe UI">

  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="40" ResizeBorderThickness="6"
                        GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
  </shell:WindowChrome.WindowChrome>

  <!-- Root layout: Aurora Showcase Studio architecture (Widescreen Topbar + 3-Column Battlestation Studio) -->
  <Grid FlowDirection="LeftToRight">
    <Grid.RowDefinitions>
      <RowDefinition Height="64"/>    <!-- Topbar & Horizontal Navigation -->
      <RowDefinition Height="Auto"/>  <!-- System Warning Banners -->
      <RowDefinition Height="*"/>     <!-- Main Content Column / Pages -->
    </Grid.RowDefinitions>

    <!-- ══════════════════ 1. TOPBAR & HORIZONTAL NAVIGATION ══════════════════ -->
    <Grid Grid.Row="0" Background="#0C101E">
      <Border BorderBrush="#1C273E" BorderThickness="0,0,0,1"/>
      <Grid x:Name="TopbarFlow" Margin="20,0,14,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/> <!-- Brand Mark -->
          <ColumnDefinition Width="*"/>    <!-- Center Navigation Tabs -->
          <ColumnDefinition Width="Auto"/> <!-- Status, Profile, Controls -->
        </Grid.ColumnDefinitions>

        <!-- Brand Mark & Title -->
        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
          <Border Width="36" Height="36" CornerRadius="10" Background="{StaticResource BrandMark}"
                  Margin="0,0,10,0">
            <Border.Effect>
              <DropShadowEffect Color="#38BDF8" BlurRadius="14" ShadowDepth="0" Opacity="0.45"/>
            </Border.Effect>
            <Border BorderBrush="#4AFFFFFF" BorderThickness="1" CornerRadius="9" Margin="1.5">
              <TextBlock Text="&#xE781;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                         Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
          </Border>
          <StackPanel VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" FlowDirection="LeftToRight">
              <TextBlock Text="Full" FontSize="18" FontWeight="Bold" Foreground="White"/>
              <TextBlock Text="RGB" FontSize="18" FontWeight="Bold" Foreground="#38BDF8"/>
            </StackPanel>
            <TextBlock x:Name="BrandTagTxt" Text="CHROMA STUDIO · v1.7"
                       FontSize="7.5" FontWeight="SemiBold" Foreground="#38BDF8"
                       Margin="0,1,0,0" FlowDirection="LeftToRight"/>
          </StackPanel>
        </StackPanel>

        <!-- Horizontal Studio Navigation Tabs -->
        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True">
          <RadioButton x:Name="TabLighting" GroupName="nav" Style="{StaticResource NavTab}"
                       Tag="&#xE781;" Content="استودیو نورپردازی" IsChecked="True" Checked="Tab_Changed"
                       shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
          <RadioButton x:Name="TabDevices" GroupName="nav" Style="{StaticResource NavTab}"
                       Tag="&#xE977;" Content="دستگاه‌ها" Checked="Tab_Changed"
                       shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
          <RadioButton x:Name="TabHardware" GroupName="nav" Style="{StaticResource NavTab}"
                       Tag="&#xE7F4;" Content="سخت‌افزار" Checked="Tab_Changed"
                       shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
          <RadioButton x:Name="TabSettings" GroupName="nav" Style="{StaticResource NavTab}"
                       Tag="&#xE713;" Content="تنظیمات" Checked="Tab_Changed"
                       shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
        </StackPanel>

        <!-- Right Utilities & Caption Controls -->
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" FlowDirection="LeftToRight">
          <!-- Profile picker -->
          <Button x:Name="ProfileQuickBtn" Style="{StaticResource ProfileSelectBtn}"
                  Click="ProfileQuick_Click" Margin="0,0,8,0"
                  shell:WindowChrome.IsHitTestVisibleInChrome="True"/>

          <!-- Power button -->
          <Button x:Name="PowerBtn" Style="{StaticResource PowerBtn}" Click="Power_Click"
                  ToolTip="Power" Margin="0,0,8,0"
                  shell:WindowChrome.IsHitTestVisibleInChrome="True"/>

          <!-- Status pill / rescan -->
          <Border x:Name="StatusPill" Background="#141E33" BorderBrush="#202F4E" BorderThickness="1"
                  CornerRadius="8" Padding="10,6" Margin="0,0,8,0" Cursor="Hand"
                  MouseLeftButtonUp="StatusPill_Click"
                  shell:WindowChrome.IsHitTestVisibleInChrome="True"
                  ToolTip="Rescan">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <Ellipse x:Name="StatusDot" Width="6" Height="6" Fill="{DynamicResource Faint}"
                       VerticalAlignment="Center" Margin="0,0,6,0"/>
              <TextBlock x:Name="StatusTxt" Foreground="#9FB2D8" FontSize="10.5"
                         VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="160"/>
              <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                         Foreground="#889DC2" Margin="6,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
          </Border>

          <!-- Language toggle -->
          <Button x:Name="LangBtn" Style="{StaticResource GhostBtn}"
                  Click="LangBtn_Click" FontSize="11" FontWeight="SemiBold"
                  Margin="0,0,8,0" Padding="8,5" MinWidth="36"
                  shell:WindowChrome.IsHitTestVisibleInChrome="True"/>

          <Border Width="1" Height="20" Background="#1D263D" VerticalAlignment="Center" Margin="0,0,8,0"/>

          <!-- Caption buttons -->
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                      shell:WindowChrome.IsHitTestVisibleInChrome="True">
            <Button x:Name="MinBtn" Style="{StaticResource CaptionBtn}" Click="Min_Click"
                    Content="&#xE921;"/>
            <Button x:Name="MaxBtn" Style="{StaticResource CaptionBtn}" Click="Max_Click"
                    Content="&#xE922;"/>
            <Button x:Name="CloseBtn2" Style="{StaticResource CloseBtn}" Click="CloseWin_Click"
                    Content="&#xE8BB;"/>
          </StackPanel>
        </StackPanel>
      </Grid>
    </Grid>

    <!-- ══════════════════ 2. BANNERS ══════════════════ -->
    <StackPanel Grid.Row="1" x:Name="BannerHost" Margin="20,0,20,0">
      <Border x:Name="IcueBanner" Background="{StaticResource WarnBg}" CornerRadius="10"
              Padding="13,10" Margin="0,10,0,6" Visibility="Collapsed"
              BorderBrush="#3A2F16" BorderThickness="1">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                     Foreground="{StaticResource Warn}" VerticalAlignment="Center" Margin="0,0,10,0"/>
          <TextBlock x:Name="IcueTxt" Grid.Column="1" TextWrapping="Wrap" FontSize="11.5"
                     Foreground="{StaticResource Warn}" VerticalAlignment="Center"/>
          <Button x:Name="CloseIcueBtn" Grid.Column="2" Style="{StaticResource Btn}" Click="CloseIcue_Click"
                  Margin="10,0,0,0" Foreground="{StaticResource Warn}" FontSize="11"/>
        </Grid>
      </Border>

      <Border x:Name="OpenRgbBanner" Background="{StaticResource WarnBg}" CornerRadius="10"
              Padding="13,10" Margin="0,10,0,6" Visibility="Collapsed"
              BorderBrush="#3A2F16" BorderThickness="1">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                     Foreground="{StaticResource Warn}" VerticalAlignment="Center" Margin="0,0,10,0"/>
          <TextBlock x:Name="OpenRgbTxt" Grid.Column="1" TextWrapping="Wrap" FontSize="11.5"
                     Foreground="{StaticResource Warn}" VerticalAlignment="Center"/>
          <Button x:Name="CloseOpenRgbBtn" Grid.Column="2" Style="{StaticResource Btn}"
                  Click="CloseOpenRgb_Click" Margin="10,0,0,0"
                  Foreground="{StaticResource Warn}" FontSize="11"/>
        </Grid>
      </Border>

      <Border x:Name="SmbusBanner" Background="{StaticResource WarnBg}" CornerRadius="10"
              Padding="13,10" Margin="0,10,0,6" Visibility="Collapsed"
              BorderBrush="#3A2F16" BorderThickness="1">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" Text="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                     Foreground="{StaticResource Warn}" VerticalAlignment="Top" Margin="0,1,10,0"/>
          <TextBlock x:Name="SmbusTxt" Grid.Column="1" TextWrapping="Wrap" FontSize="11.5"
                     Foreground="{StaticResource Warn}"/>
        </Grid>
      </Border>

      <Border x:Name="SafeModeBanner" Background="{StaticResource WarnBg}" CornerRadius="10"
              Padding="13,10" Margin="0,10,0,6" Visibility="Collapsed"
              BorderBrush="#3A2F16" BorderThickness="1">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                     Foreground="{StaticResource Warn}" VerticalAlignment="Center" Margin="0,0,10,0"/>
          <TextBlock x:Name="SafeModeTxt" Grid.Column="1" TextWrapping="Wrap" FontSize="11.5"
                     Foreground="{StaticResource Warn}" VerticalAlignment="Center"/>
          <Button x:Name="SafeModeRetryBtn" Grid.Column="2" Style="{StaticResource Btn}"
                  Click="SafeModeRetry_Click" Margin="10,0,0,0"
                  Foreground="{StaticResource Warn}" FontSize="11"/>
        </Grid>
      </Border>
    </StackPanel>

    <!-- ══════════════════ 3. MAIN CONTENT COLUMN ══════════════════ -->
    <Grid x:Name="MainCol" Grid.Row="2">

      <!-- ─── 3.1. LIGHTING STUDIO (Aurora Battlestation Showcase) ─── -->
      <Grid x:Name="PageLighting" Margin="18,10,18,12">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="230"/>  <!-- Left: My Devices Rail -->
          <ColumnDefinition Width="*"/>    <!-- Center: Battlestation Stage + Fx Carousel -->
          <ColumnDefinition Width="290"/>  <!-- Right: Effect Customization Inspector -->
        </Grid.ColumnDefinitions>

        <!-- Left Column: My Devices Rail -->
        <Border Grid.Column="0" CornerRadius="16" Margin="0,0,10,0"
                BorderBrush="#1C273E" BorderThickness="1">
          <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
              <GradientStop Color="#101628" Offset="0"/>
              <GradientStop Color="#0A0E18" Offset="1"/>
            </LinearGradientBrush>
          </Border.Background>
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="46"/>   <!-- Header -->
              <RowDefinition Height="*"/>    <!-- Device List -->
              <RowDefinition Height="Auto"/> <!-- Engine Status Card -->
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="14,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <Border Grid.ColumnSpan="2" BorderBrush="#1A243A" BorderThickness="0,0,0,1" VerticalAlignment="Bottom"/>
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="&#xE977;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                           Foreground="#38BDF8" VerticalAlignment="Center"/>
                <TextBlock x:Name="ConnHdr" Text="دستگاه‌های متصل" FontSize="12" FontWeight="Bold"
                           Foreground="{StaticResource Text}" Margin="7,0,0,0"
                           VerticalAlignment="Center"/>
              </StackPanel>
              <Border Grid.Column="1" Background="#1C2C47" BorderBrush="#2A4066"
                      BorderThickness="1" CornerRadius="6" Padding="6,2"
                      VerticalAlignment="Center">
                <TextBlock x:Name="TargetHdr" FontSize="9" FontWeight="SemiBold" Foreground="#38BDF8"/>
              </Border>
            </Grid>

            <!-- Device list -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="10,10,10,8">
              <StackPanel>
                <StackPanel x:Name="DeviceList"/>
                <TextBlock x:Name="OverrideHint" FontSize="9.5" Foreground="#6C7F9E"
                           Margin="4,6,4,0" TextWrapping="Wrap"/>
              </StackPanel>
            </ScrollViewer>

            <!-- Engine card at bottom of left rail -->
            <Border Grid.Row="2" CornerRadius="10" Margin="10,0,10,10"
                    BorderBrush="#192A3A" BorderThickness="1" Padding="10,8"
                    Background="#0D1526">
              <StackPanel>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" Text="&#xE781;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                             Foreground="#38BDF8" VerticalAlignment="Center" Margin="0,0,6,0"/>
                  <TextBlock x:Name="EngineTitleTxt" Grid.Column="1" Text="موتور نورپردازی" FontSize="10" FontWeight="SemiBold"
                             Foreground="#B0C4DE" VerticalAlignment="Center"/>
                  <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="EngineStateDot" Width="5" Height="5" Fill="{DynamicResource Faint}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBlock x:Name="EngineStateTxt" Text="—" FontSize="9" Foreground="#38BDF8" VerticalAlignment="Center"/>
                  </StackPanel>
                </Grid>
                <TextBlock x:Name="EngineStatsTxt" Text="" FontSize="8.5" Foreground="#6C7F9E" Margin="0,3,0,0"/>
              </StackPanel>
            </Border>
          </Grid>
        </Border>

        <!-- Center Column: Full Studio Effect Catalog (All 19 Effects in spacious 4-column grid) -->
        <Border Grid.Column="1" CornerRadius="16" Margin="0,0,10,0"
                BorderBrush="#1C273E" BorderThickness="1">
          <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
              <GradientStop Color="#101628" Offset="0"/>
              <GradientStop Color="#090D18" Offset="1"/>
            </LinearGradientBrush>
          </Border.Background>
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="50"/>  <!-- Header -->
              <RowDefinition Height="*"/>   <!-- Effects Grid -->
              <RowDefinition Height="36"/>  <!-- Footer -->
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="16,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <Border Grid.ColumnSpan="3" BorderBrush="#1A243A" BorderThickness="0,0,0,1" VerticalAlignment="Bottom"/>

              <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="&#xE781;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                           Foreground="#38BDF8" VerticalAlignment="Center"/>
                <TextBlock x:Name="EffectHdr" FontSize="13" FontWeight="Bold"
                           Foreground="{StaticResource Text}" Margin="8,0,0,0"
                           VerticalAlignment="Center"/>
                <Border Background="#1C2C47" BorderBrush="#2A4066"
                        BorderThickness="1" CornerRadius="6" Padding="7,2" Margin="9,0,0,0"
                        VerticalAlignment="Center">
                  <TextBlock x:Name="FxCountTxt" FontSize="9.5" FontWeight="SemiBold" Foreground="#38BDF8"/>
                </Border>
              </StackPanel>

              <TextBlock x:Name="FxHintTxt" Grid.Column="1" HorizontalAlignment="Center" FontSize="10" Foreground="#7E94B8"
                         VerticalAlignment="Center"/>

              <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="PageTitleTxt" FontSize="12" FontWeight="SemiBold"
                           Foreground="{StaticResource Text}" VerticalAlignment="Center"/>
                <Border Background="#12253D" BorderBrush="#254366" BorderThickness="1"
                        CornerRadius="7" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center">
                  <StackPanel Orientation="Horizontal">
                    <Ellipse Width="5" Height="5" Fill="#34D399" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBlock Text="RGB STUDIO · 60 FPS" FontSize="9" FontWeight="SemiBold"
                               Foreground="#38BDF8" VerticalAlignment="Center"/>
                  </StackPanel>
                </Border>
              </StackPanel>
            </Grid>

            <!-- Full-Height Effect Grid with ScrollViewer -->
            <ScrollViewer Grid.Row="1" x:Name="FxScrollViewer"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Margin="12,10,12,6">
              <UniformGrid x:Name="EffectChips" Columns="4"/>
            </ScrollViewer>

            <!-- Footer -->
            <Grid Grid.Row="2" Margin="16,0">
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="10.5"
                           Foreground="#6C7F9E" VerticalAlignment="Center"/>
                <TextBlock x:Name="FxFooterTxt" FontSize="9.5" Foreground="#6C7F9E"
                           Margin="6,0,0,0" VerticalAlignment="Center"/>
              </StackPanel>
            </Grid>
          </Grid>
        </Border>

        <!-- Right Column: Effect Customization Inspector -->
        <Border Grid.Column="2" CornerRadius="16" BorderBrush="#1C273E" BorderThickness="1">
          <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
              <GradientStop Color="#101628" Offset="0"/>
              <GradientStop Color="#0A0E18" Offset="1"/>
            </LinearGradientBrush>
          </Border.Background>
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="46"/>   <!-- Header -->
              <RowDefinition Height="*"/>    <!-- Parameters -->
              <RowDefinition Height="Auto"/> <!-- Action Dock -->
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="14,0">
              <Border BorderBrush="#1A243A" BorderThickness="0,0,0,1" VerticalAlignment="Bottom"/>
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="&#xE9E9;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                           Foreground="#38BDF8" VerticalAlignment="Center">
                  <TextBlock.Effect>
                    <DropShadowEffect Color="#38BDF8" BlurRadius="6" ShadowDepth="0" Opacity="0.8"/>
                  </TextBlock.Effect>
                </TextBlock>
                <TextBlock x:Name="ControlsHdr" FontSize="12" FontWeight="Bold"
                           Foreground="{StaticResource Text}" Margin="8,0,0,0"
                           VerticalAlignment="Center"/>
              </StackPanel>
            </Grid>

            <!-- Parameter Widgets -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="12,8,12,6">
              <StackPanel x:Name="EffectParams"/>
            </ScrollViewer>

            <!-- Action Dock at bottom of right column -->
            <Border Grid.Row="2" BorderBrush="#1A243A" BorderThickness="0,1,0,0" Padding="12,10">
              <Grid x:Name="ActionBarFlow">
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <!-- Apply / Save button -->
                <Button x:Name="SaveBtn" Grid.Row="0" Click="SaveProfile_Click"
                        Foreground="#FFFFFF" FontSize="12" FontWeight="Bold" Height="40"
                        Cursor="Hand" Margin="0,0,0,8">
                  <Button.Template>
                    <ControlTemplate TargetType="Button">
                      <Border x:Name="bd" CornerRadius="10" Padding="{TemplateBinding Padding}">
                        <Border.Background>
                          <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#0284C7" Offset="0"/>
                            <GradientStop Color="#38BDF8" Offset="1"/>
                          </LinearGradientBrush>
                        </Border.Background>
                        <Border.Effect>
                          <DropShadowEffect Color="#38BDF8" BlurRadius="12" ShadowDepth="0" Opacity="0.5"/>
                        </Border.Effect>
                        <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                      </Border>
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                          <Setter TargetName="bd" Property="Opacity" Value="0.9"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                          <Setter TargetName="bd" Property="Opacity" Value="0.75"/>
                        </Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Button.Template>
                </Button>

                <!-- Sub action buttons -->
                <Grid Grid.Row="1">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <Button x:Name="StopBtn" Grid.Column="0" Style="{StaticResource Btn}"
                          Click="StopEffects_Click" Margin="0,0,4,0"/>
                  <Button x:Name="BlackoutBtn" Grid.Column="1" Style="{StaticResource Btn}"
                          Foreground="{DynamicResource Muted}" Click="Blackout_Click" Margin="4,0,0,0"/>
                </Grid>
              </Grid>
            </Border>
          </Grid>
        </Border>
      </Grid>

      <!-- ─── 3.2. DEVICES PAGE ─── -->
      <Grid x:Name="PageDevices" Visibility="Collapsed" Margin="24,14,24,14">
        <Grid.RowDefinitions>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <Border x:Name="DevEmptyCard" Style="{StaticResource CardBd}" Margin="0,0,0,12"
                    Visibility="Collapsed" Padding="18,22">
              <StackPanel HorizontalAlignment="Center">
                <TextBlock Text="&#xEA80;" FontFamily="Segoe MDL2 Assets" FontSize="26"
                           Foreground="{DynamicResource Faint}" HorizontalAlignment="Center"/>
                <TextBlock x:Name="DevEmptyTxt" Style="{StaticResource MutedTxt}" TextWrapping="Wrap"
                           TextAlignment="Center" Margin="0,12,0,14" MaxWidth="300"/>
                <Button x:Name="DevEmptyBtn" Style="{StaticResource Btn}" Click="Rescan_Click"
                        HorizontalAlignment="Center"/>
              </StackPanel>
            </Border>

            <Border x:Name="DevPickCard" Style="{StaticResource CardBd}" Margin="0,0,0,12">
              <StackPanel>
                <TextBlock x:Name="DevPickHdr" Style="{StaticResource SectionHdr}" Margin="0,0,0,10"/>
                <StackPanel x:Name="DevPickList"/>
              </StackPanel>
            </Border>

            <Border x:Name="ZoneCard" Style="{StaticResource CardBd}" Margin="0,0,0,12" Visibility="Collapsed">
              <StackPanel>
                <TextBlock x:Name="ZoneHdr" Style="{StaticResource SectionHdr}" Margin="0,0,0,4"/>
                <TextBlock x:Name="ZoneHint" Style="{StaticResource FaintTxt}" TextWrapping="Wrap" Margin="0,0,0,11"/>
                <StackPanel x:Name="ZoneList"/>
                <Button x:Name="ZoneApplyBtn" Style="{StaticResource Btn}" Click="ZoneApply_Click"
                        HorizontalAlignment="Left" Margin="0,4,0,0" FontSize="11"/>
              </StackPanel>
            </Border>

            <Border x:Name="CalCard" Style="{StaticResource CardBd}" Margin="0,0,0,12" Visibility="Collapsed">
              <StackPanel>
                <TextBlock x:Name="CalHdr" Style="{StaticResource SectionHdr}" Margin="0,0,0,4"/>
                <TextBlock x:Name="CalHint" Style="{StaticResource FaintTxt}" TextWrapping="Wrap" Margin="0,0,0,11"/>
                <StackPanel x:Name="CalPanel"/>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBd}" Margin="0,0,0,4">
              <Expander x:Name="HelpExp">
                <TextBlock x:Name="MissingTxt" Style="{StaticResource FaintTxt}" TextWrapping="Wrap"
                           Margin="2,8,0,2"/>
              </Expander>
            </Border>
          </StackPanel>
        </ScrollViewer>

        <!-- always-visible rescan at the bottom -->
        <Border Grid.Row="1" Background="{StaticResource Card}" BorderBrush="{StaticResource Border}"
                BorderThickness="1" CornerRadius="10" Margin="0,12,0,0" Padding="14,12">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="DevRescanHint" Style="{StaticResource FaintTxt}" TextWrapping="Wrap"
                       VerticalAlignment="Center"/>
            <Button x:Name="DevRescanBtn" Grid.Column="1" Style="{StaticResource AccentBtn}"
                    Click="Rescan_Click" MinWidth="140" Content="Rescan"/>
          </Grid>
        </Border>
      </Grid>

      <!-- ─── 3.3. HARDWARE PAGE ─── -->
      <ScrollViewer x:Name="PageHardware" VerticalScrollBarVisibility="Auto" Padding="24,14,24,14"
                    Visibility="Collapsed">
        <StackPanel>
          <StackPanel x:Name="HwList"/>

          <Border Style="{StaticResource CardBd}" Margin="0,0,0,12">
            <StackPanel>
              <TextBlock x:Name="AdvancedHdr" Style="{StaticResource SectionHdr}" Margin="0,0,0,9"/>
              <TextBlock x:Name="AdminTxt" Style="{StaticResource FaintTxt}" TextWrapping="Wrap"
                         Margin="0,0,0,11"/>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="PawnIoTxt" Style="{StaticResource MutedTxt}" TextWrapping="Wrap"
                           VerticalAlignment="Center" Margin="0,0,14,0"/>
                <Button x:Name="PawnIoBtn" Grid.Column="1" Style="{StaticResource Btn}"
                        Click="InstallPawnIo_Click" FontSize="11" VerticalAlignment="Center"/>
              </Grid>
              <Grid Margin="0,11,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="RamTxt" Style="{StaticResource MutedTxt}" TextWrapping="Wrap"
                           VerticalAlignment="Center" Margin="0,0,14,0"/>
                <Button x:Name="RamBtn" Grid.Column="1" Style="{StaticResource Btn}"
                        Click="EngineTask_Click" FontSize="11" VerticalAlignment="Center"/>
              </Grid>
              <ProgressBar x:Name="DepBar" Style="{StaticResource Prog}" Minimum="0" Maximum="100"
                           Margin="0,11,0,0" Visibility="Collapsed"/>
              <TextBlock x:Name="DepTxt" Style="{StaticResource FaintTxt}" Margin="0,7,0,0"
                         TextWrapping="Wrap" Visibility="Collapsed"/>
            </StackPanel>
          </Border>

          <Border Style="{StaticResource CardBd}" Margin="0,0,0,12">
            <StackPanel>
              <TextBlock x:Name="WhyHdr" Style="{StaticResource SectionHdr}" Margin="0,0,0,9"/>
              <TextBlock x:Name="Why1Txt" Style="{StaticResource FaintTxt}" TextWrapping="Wrap"
                         Margin="0,0,0,7"/>
              <TextBlock x:Name="Why2Txt" Style="{StaticResource FaintTxt}" TextWrapping="Wrap"
                         Margin="0,0,0,7"/>
              <TextBlock x:Name="Why3Txt" Style="{StaticResource FaintTxt}" TextWrapping="Wrap"/>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>

      <!-- ─── 3.4. SETTINGS PAGE ─── -->
      <ScrollViewer x:Name="PageSettings" VerticalScrollBarVisibility="Auto" Padding="24,14,24,14"
                    Visibility="Collapsed">
        <StackPanel>
          <Border Style="{StaticResource CardBd}" Margin="0,0,0,12">
            <StackPanel>
              <TextBlock x:Name="ProfileHdr" Style="{StaticResource SectionHdr}" Margin="0,0,0,10"/>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ComboBox x:Name="ProfileCmb" Grid.Column="0" Style="{StaticResource Cmb}"
                          SelectionChanged="ProfileCmb_SelectionChanged"/>
                <Button x:Name="ProfileRenameBtn" Grid.Column="1" Style="{StaticResource IconBtn}"
                        Click="ProfileRename_Click" Content="&#xE70F;" Margin="6,0,0,0"/>
                <Button x:Name="ProfileNewBtn" Grid.Column="2" Style="{StaticResource IconBtn}"
                        Click="ProfileNew_Click" Content="&#xE710;" Margin="6,0,0,0"/>
                <Button x:Name="ProfileDelBtn" Grid.Column="3" Style="{StaticResource IconBtn}"
                        Click="ProfileDel_Click" Content="&#xE74D;" Margin="6,0,0,0"
                        Foreground="{StaticResource Danger}"/>
              </Grid>
              <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <Button x:Name="ProfileExportBtn" Style="{StaticResource Btn}" Click="ProfileExport_Click"
                        FontSize="11" Margin="0,0,8,0"/>
                <Button x:Name="ProfileImportBtn" Style="{StaticResource Btn}" Click="ProfileImport_Click"
                        FontSize="11" Margin="0,0,8,0"/>
                <Button x:Name="ProfileCodeBtn" Style="{StaticResource Btn}" Click="ProfileCode_Click"
                        FontSize="11"/>
              </StackPanel>
            </StackPanel>
          </Border>

          <Border Style="{StaticResource CardBd}" Margin="0,0,0,12">
            <StackPanel>
              <TextBlock x:Name="AppearanceHdr" Style="{StaticResource SectionHdr}" Margin="0,0,0,10"/>
              <TextBlock x:Name="AccentLbl" Style="{StaticResource MutedTxt}" Margin="0,0,0,8"/>
              <WrapPanel x:Name="AccentSwatches"/>
            </StackPanel>
          </Border>

          <Border Style="{StaticResource CardBd}" Margin="0,0,0,12">
            <StackPanel>
              <TextBlock x:Name="StartupHdr" Style="{StaticResource SectionHdr}" Margin="0,0,0,11"/>
              <CheckBox x:Name="AutostartChk" Style="{StaticResource Chk}"
                        Checked="Autostart_Changed" Unchecked="Autostart_Changed"/>
              <CheckBox x:Name="MinimizedChk" Style="{StaticResource Chk}"
                        Checked="Minimized_Changed" Unchecked="Minimized_Changed"/>
              <CheckBox x:Name="AutoFxChk" Style="{StaticResource Chk}" Margin="0"
                        Checked="AutoFx_Changed" Unchecked="AutoFx_Changed"/>
              <CheckBox x:Name="CloseEngineChk" Style="{StaticResource Chk}" Margin="0,8,0,0"
                        Checked="CloseEngine_Changed" Unchecked="CloseEngine_Changed"/>
              <CheckBox x:Name="AutoRecoverChk" Style="{StaticResource Chk}" Margin="0,8,0,0"
                        Checked="AutoRecover_Changed" Unchecked="AutoRecover_Changed"/>
              <CheckBox x:Name="ReduceMotionChk" Style="{StaticResource Chk}" Margin="0,8,0,0"
                        Checked="ReduceMotion_Changed" Unchecked="ReduceMotion_Changed"/>
              <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="GlobalBrightLbl" Style="{StaticResource MutedTxt}"
                           VerticalAlignment="Center"/>
                <TextBlock x:Name="GlobalBrightVal" Grid.Column="1" Style="{StaticResource FaintTxt}"
                           VerticalAlignment="Center" MinWidth="38" TextAlignment="Right"/>
              </Grid>
              <Slider x:Name="GlobalBrightSlider" Style="{StaticResource Slider}"
                      Minimum="0.1" Maximum="1" Value="1" Margin="0,6,0,0"
                      ValueChanged="GlobalBright_Changed"/>
              <CheckBox x:Name="NightDimChk" Style="{StaticResource Chk}" Margin="0,10,0,0"
                        Checked="NightDim_Changed" Unchecked="NightDim_Changed"/>
            </StackPanel>
          </Border>

          <Border Style="{StaticResource CardBd}" Margin="0,0,0,12">
            <StackPanel>
              <TextBlock x:Name="SchedHdr" Style="{StaticResource SectionHdr}" Margin="0,0,0,11"/>
              <CheckBox x:Name="SchedChk" Style="{StaticResource Chk}"
                        Checked="Sched_Changed" Unchecked="Sched_Changed"/>
              <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="SchedEveryLbl" Style="{StaticResource MutedTxt}"
                           VerticalAlignment="Center" Margin="0,0,10,0"/>
                <ComboBox x:Name="SchedCmb" Grid.Column="1" Style="{StaticResource Cmb}"
                          SelectionChanged="SchedCmb_Changed"/>
              </Grid>
            </StackPanel>
          </Border>

          <Border Style="{StaticResource CardBd}" Margin="0,0,0,12">
            <StackPanel>
              <TextBlock x:Name="TimeSchedHdr" Style="{StaticResource SectionHdr}" Margin="0,0,0,11"/>
              <CheckBox x:Name="TimeSchedChk" Style="{StaticResource Chk}"
                        Checked="TimeSched_Changed" Unchecked="TimeSched_Changed"/>
              <TextBlock x:Name="TimeSchedHint" Style="{StaticResource FaintTxt}" TextWrapping="Wrap"
                         Margin="0,8,0,6"/>
              <TextBox x:Name="TimeSchedBox" Style="{StaticResource Inp}" AcceptsReturn="True"
                       Height="70" VerticalScrollBarVisibility="Auto" LostFocus="TimeSched_Save"
                       FontFamily="Consolas"/>
            </StackPanel>
          </Border>

          <Border Style="{StaticResource CardBd}" Margin="0,0,0,12">
            <StackPanel>
              <TextBlock x:Name="HotkeyHdr" Style="{StaticResource SectionHdr}" Margin="0,0,0,11"/>
              <TextBlock x:Name="HotkeyHint" Style="{StaticResource FaintTxt}" TextWrapping="Wrap"
                         Margin="0,0,0,10"/>
              <Grid Margin="0,0,0,7">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="190"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="HotkeyToggleLbl" Style="{StaticResource MutedTxt}"
                           VerticalAlignment="Center"/>
                <TextBox x:Name="HotkeyToggleBox" Grid.Column="1" Style="{StaticResource Inp}"/>
              </Grid>
              <Grid Margin="0,0,0,7">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="190"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="HotkeyBlackoutLbl" Style="{StaticResource MutedTxt}"
                           VerticalAlignment="Center"/>
                <TextBox x:Name="HotkeyBlackoutBox" Grid.Column="1" Style="{StaticResource Inp}"/>
              </Grid>
              <Grid Margin="0,0,0,11">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="190"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="HotkeyNextLbl" Style="{StaticResource MutedTxt}"
                           VerticalAlignment="Center"/>
                <TextBox x:Name="HotkeyNextBox" Grid.Column="1" Style="{StaticResource Inp}"/>
              </Grid>
              <Button x:Name="HotkeyApplyBtn" Style="{StaticResource Btn}"
                      HorizontalAlignment="Left" Click="HotkeyApply_Click"/>
            </StackPanel>
          </Border>

          <Border Style="{StaticResource CardBd}" Margin="0,0,0,12">
            <StackPanel>
              <TextBlock x:Name="FgHdr" Style="{StaticResource SectionHdr}" Margin="0,0,0,11"/>
              <CheckBox x:Name="FgChk" Style="{StaticResource Chk}"
                        Checked="Fg_Changed" Unchecked="Fg_Changed"/>
              <TextBlock x:Name="FgHint" Style="{StaticResource FaintTxt}" TextWrapping="Wrap"
                         Margin="0,8,0,6"/>
              <TextBox x:Name="FgMapBox" Style="{StaticResource Inp}" AcceptsReturn="True"
                       Height="64" VerticalScrollBarVisibility="Auto" LostFocus="FgMap_Save"/>
              <StackPanel Orientation="Horizontal" Margin="0,9,0,0">
                <Button x:Name="FgAddCurrentBtn" Style="{StaticResource Btn}" Click="FgAddCurrent_Click"
                        FontSize="11"/>
              </StackPanel>
            </StackPanel>
          </Border>

          <Border Style="{StaticResource CardBd}" Margin="0,0,0,12">
            <StackPanel>
              <TextBlock x:Name="CompanionHdr" Style="{StaticResource SectionHdr}" Margin="0,0,0,11"/>
              <CheckBox x:Name="CompanionChk" Style="{StaticResource Chk}"
                        Checked="Companion_Changed" Unchecked="Companion_Changed"/>
              <TextBlock x:Name="CompanionHint" Style="{StaticResource FaintTxt}" TextWrapping="Wrap"
                         Margin="0,8,0,8"/>
              <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <Button x:Name="CompanionOpenBtn" Style="{StaticResource Btn}" Click="CompanionOpen_Click"
                        FontSize="11" Margin="0,0,8,0"/>
                <Button x:Name="CompanionCopyBtn" Style="{StaticResource Btn}" Click="CompanionCopy_Click"
                        FontSize="11"/>
              </StackPanel>
              <TextBlock x:Name="CompanionInfoTxt" Style="{StaticResource FaintTxt}" TextWrapping="Wrap"
                         FontFamily="Consolas"/>
            </StackPanel>
          </Border>

          <Border Style="{StaticResource CardBd}" Margin="0,0,0,12">
            <StackPanel>
              <TextBlock x:Name="UpdateHdr" Style="{StaticResource SectionHdr}" Margin="0,0,0,11"/>
              <CheckBox x:Name="UpdateChk" Style="{StaticResource Chk}"
                        Checked="Update_Changed" Unchecked="Update_Changed"/>
              <CheckBox x:Name="BetaChk" Style="{StaticResource Chk}" Margin="0,7,0,0"
                        Checked="Update_Changed" Unchecked="Update_Changed"/>
              <TextBlock x:Name="BetaHint" Style="{StaticResource FaintTxt}" TextWrapping="Wrap"
                         Margin="0,6,0,0"/>
              <TextBlock x:Name="UpdateTxt" Style="{StaticResource FaintTxt}" TextWrapping="Wrap"
                         Margin="0,9,0,0"/>
              <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <Button x:Name="UpdateCheckBtn" Style="{StaticResource Btn}" Click="UpdateCheck_Click"
                        FontSize="11" Margin="0,0,8,0"/>
                <Button x:Name="UpdateInstallBtn" Style="{StaticResource AccentBtn}" Click="UpdateInstall_Click"
                        FontSize="11" Visibility="Collapsed"/>
              </StackPanel>
            </StackPanel>
          </Border>

          <Border Style="{StaticResource CardBd}" Margin="0,0,0,12">
            <StackPanel>
              <TextBlock x:Name="BackupHdr" Style="{StaticResource SectionHdr}" Margin="0,0,0,11"/>
              <StackPanel Orientation="Horizontal">
                <Button x:Name="ExportBtn" Style="{StaticResource Btn}" Click="Export_Click" Margin="0,0,8,0"/>
                <Button x:Name="ImportBtn" Style="{StaticResource Btn}" Click="Import_Click"/>
              </StackPanel>
            </StackPanel>
          </Border>

          <Border Style="{StaticResource CardBd}" Margin="0,0,0,12">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Border Width="55" Height="55" CornerRadius="14" Background="{StaticResource BrandMark}"
                      VerticalAlignment="Top" Margin="0,0,18,0">
                <Border BorderBrush="#4AFFFFFF" BorderThickness="1" CornerRadius="11" Margin="2"/>
              </Border>
              <StackPanel Grid.Column="1">
                <TextBlock x:Name="AboutHdr" Style="{StaticResource SectionHdr}" Margin="0,0,0,9"/>
                <TextBlock x:Name="AboutTxt" Style="{StaticResource FaintTxt}" TextWrapping="Wrap"/>
                <TextBlock x:Name="DiagTxt" Style="{StaticResource FaintTxt}" TextWrapping="Wrap"
                           Margin="0,9,0,0"/>
              </StackPanel>
            </Grid>
          </Border>
        </StackPanel>
      </ScrollViewer>

      <!-- ─── 3.5. STUBS & COMPATIBILITY LAYER ─── -->
      <!-- Preserves all variables touched by code-behind so no null reference or test failure occurs -->
      <Grid Visibility="Collapsed">
        <StackPanel x:Name="SidebarFlow"/>
        <StackPanel x:Name="PageHeading"/>
        <TextBlock x:Name="PageEyebrow"/>
        <TextBlock x:Name="SubTitleTxt"/>
        <TextBlock x:Name="PageCrumb"/>
        <TextBlock x:Name="HeroLiveTxt"/>
        <TextBlock x:Name="HeroL1Txt"/>
        <TextBlock x:Name="HeroL2Txt"/>
        <TextBlock x:Name="HeroFxTxt"/>
        <TextBlock x:Name="HeroSubTxt"/>
        <TextBlock x:Name="HeroTagDevTxt"/>
        <TextBlock x:Name="HeroTagFxTxt"/>
        <TextBlock x:Name="HeroCornerTxt"/>
        <Border x:Name="PreviewHost"><Image x:Name="PreviewImg"/></Border>
        <TextBlock x:Name="StatDevLbl"/><TextBlock x:Name="StatDevVal"/><TextBlock x:Name="StatDevUnit"/>
        <TextBlock x:Name="StatLedLbl"/><TextBlock x:Name="StatLedVal"/>
        <TextBlock x:Name="StatFxLbl"/><TextBlock x:Name="StatFxVal"/>
        <TextBlock x:Name="StatSyncLbl"/><TextBlock x:Name="StatSyncVal"/>
        <Ellipse x:Name="StatSyncDot"/>
        <TextBlock x:Name="ConnCountTxt"/>
        <Button x:Name="ConnManageBtn"/>
        <UniformGrid x:Name="ConnectedGrid"/>
        <TextBlock x:Name="VersionTxt"/>
      </Grid>

    </Grid>
  </Grid>
</Window>
