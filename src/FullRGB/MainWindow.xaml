<Window x:Class="FullRGB.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="FullRGB" Height="700" Width="560" MinWidth="480" MinHeight="560"
        Background="{StaticResource AppBackdrop}" WindowStartupLocation="CenterScreen"
        TextOptions.TextFormattingMode="Ideal" UseLayoutRounding="True" SnapsToDevicePixels="True"
        WindowStyle="None" ResizeMode="CanResize"
        FontFamily="Segoe UI Variable Text, Segoe UI">

  <!-- Custom chrome: keeps Windows' own resize/snap/aero behaviour (unlike AllowsTransparency),
       while letting us draw our own title bar. GlassFrameThickness=0 hides the system caption. -->
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="40" ResizeBorderThickness="6"
                        GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
  </shell:WindowChrome.WindowChrome>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>   <!-- title bar -->
      <RowDefinition Height="Auto"/>   <!-- banners -->
      <RowDefinition Height="*"/>      <!-- nav + page -->
      <RowDefinition Height="Auto"/>   <!-- action bar -->
    </Grid.RowDefinitions>

    <!-- ═════════ title bar ═════════ -->
    <Grid Grid.Row="0" Height="52" Background="Transparent">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>

      <!-- brand mark: three arcs, same geometry as the app icon -->
      <Grid Grid.Column="0" Width="30" Height="30" Margin="16,0,11,0" VerticalAlignment="Center">
        <Ellipse Width="30" Height="30" Stroke="{DynamicResource BrandGrad}" StrokeThickness="3.4"
                 StrokeDashArray="3.05 1.05" StrokeDashCap="Flat"/>
        <Ellipse Width="7" Height="7" Fill="{StaticResource Text}"/>
      </Grid>

      <StackPanel Grid.Column="1" VerticalAlignment="Center">
        <TextBlock Text="FullRGB" FontSize="14.5" FontWeight="SemiBold"
                   Foreground="{StaticResource Text}"/>
        <TextBlock x:Name="SubTitleTxt" Style="{StaticResource FaintTxt}" Margin="0,1,0,0"
                   TextTrimming="CharacterEllipsis"/>
      </StackPanel>

      <!-- live status pill: dot + label + refresh glyph, click to rescan.
           Deliberately a Border (not a templated Button): x:Name inside a ControlTemplate
           does not produce a code-behind field, and the dot/text are updated from code. -->
      <Border x:Name="StatusPill" Grid.Column="2" Background="{StaticResource Surface}"
              CornerRadius="14" BorderBrush="{StaticResource Border}" BorderThickness="1"
              Padding="10,6" Margin="0,0,8,0" VerticalAlignment="Center" Cursor="Hand"
              MouseLeftButtonUp="StatusPill_Click"
              shell:WindowChrome.IsHitTestVisibleInChrome="True">
        <StackPanel Orientation="Horizontal">
          <Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="{DynamicResource Faint}"
                   VerticalAlignment="Center" Margin="0,0,7,0"/>
          <TextBlock x:Name="StatusTxt" Foreground="{StaticResource Muted}" FontSize="10.5"
                     VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="180"/>
          <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="9"
                     Foreground="{StaticResource Faint}" VerticalAlignment="Center"
                     Margin="8,0,0,0"/>
        </StackPanel>
      </Border>

      <!-- caption controls -->
      <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Top"
                  shell:WindowChrome.IsHitTestVisibleInChrome="True" Margin="0,4,4,0">
        <Button x:Name="LangBtn" Style="{StaticResource CaptionBtn}" Click="LangBtn_Click"
                FontFamily="Segoe UI" FontSize="10.5" FontWeight="SemiBold" Width="38"/>
        <Button x:Name="MinBtn" Style="{StaticResource CaptionBtn}" Click="Min_Click"
                Content="&#xE921;"/>
        <Button x:Name="MaxBtn" Style="{StaticResource CaptionBtn}" Click="Max_Click"
                Content="&#xE922;"/>
        <Button x:Name="CloseBtn2" Style="{StaticResource CloseBtn}" Click="CloseWin_Click"
                Content="&#xE8BB;"/>
      </StackPanel>
    </Grid>

    <!-- ═════════ banners ═════════ -->
    <StackPanel Grid.Row="1" Margin="14,0,14,0">
      <Border x:Name="IcueBanner" Background="{StaticResource WarnBg}" CornerRadius="12"
              Padding="13,10" Margin="0,0,0,8" Visibility="Collapsed"
              BorderBrush="#3A2F16" BorderThickness="1">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                     Foreground="{StaticResource Warn}" VerticalAlignment="Center" Margin="0,0,10,0"/>
          <TextBlock x:Name="IcueTxt" Grid.Column="1" TextWrapping="Wrap" FontSize="11.5"
                     Foreground="{StaticResource Warn}" VerticalAlignment="Center"/>
          <Button x:Name="CloseIcueBtn" Grid.Column="2" Style="{StaticResource Btn}" Click="CloseIcue_Click"
                  Margin="10,0,0,0" Foreground="{StaticResource Warn}" FontSize="11"/>
        </Grid>
      </Border>

      <Border x:Name="SmbusBanner" Background="{StaticResource WarnBg}" CornerRadius="12"
              Padding="13,10" Margin="0,0,0,8" Visibility="Collapsed"
              BorderBrush="#3A2F16" BorderThickness="1">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" Text="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                     Foreground="{StaticResource Warn}" VerticalAlignment="Top" Margin="0,1,10,0"/>
          <TextBlock x:Name="SmbusTxt" Grid.Column="1" TextWrapping="Wrap" FontSize="11.5"
                     Foreground="{StaticResource Warn}"/>
        </Grid>
      </Border>
    </StackPanel>

    <!-- ═════════ nav rail + pages ═════════ -->
    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <!-- vertical rail replaces the old horizontal tab strip: it frees a full row of
           height and reads as an app shell instead of a settings dialog. It spans the
           full height (with its own faint background) so it does not stop mid-window. -->
      <Border Grid.Column="0" Width="74" Background="{DynamicResource BgElevated}"
              BorderBrush="{DynamicResource BorderSoft}" BorderThickness="0,0,1,0">
        <StackPanel VerticalAlignment="Top" Margin="0,4,0,0">
          <RadioButton x:Name="TabLighting" GroupName="nav" Style="{StaticResource NavTab}"
                       Tag="&#xE781;" IsChecked="True" Checked="Tab_Changed"/>
          <RadioButton x:Name="TabDevices" GroupName="nav" Style="{StaticResource NavTab}"
                       Tag="&#xE977;" Checked="Tab_Changed"/>
          <!-- Hardware: what is on this PC, what the engine can drive, and WHY the rest cannot.
               In the rail on purpose — this used to be buried in Settings > Advanced, where a
               first-run user never found the answer to "why is my mouse missing?". -->
          <RadioButton x:Name="TabHardware" GroupName="nav" Style="{StaticResource NavTab}"
                       Tag="&#xE7F4;" Checked="Tab_Changed"/>
          <RadioButton x:Name="TabSettings" GroupName="nav" Style="{StaticResource NavTab}"
                       Tag="&#xE713;" Checked="Tab_Changed"/>
        </StackPanel>
      </Border>

      <Grid Grid.Column="1">

        <!-- === LIGHTING === -->
        <ScrollViewer x:Name="PageLighting" VerticalScrollBarVisibility="Auto" Padding="6,4,10,18">
          <StackPanel>

            <!-- hero: live preview + the effect name, the first thing the eye lands on -->
            <Border Style="{StaticResource CardBd}" Margin="0,0,0,10" Padding="0"
                    ClipToBounds="True">
              <StackPanel>
                <Border x:Name="PreviewHost" Height="86" CornerRadius="15,15,0,0" ClipToBounds="True">
                  <Grid>
                    <Image x:Name="PreviewImg" Stretch="Fill"/>
                    <!-- top-down scrim so the caption stays readable over any colour -->
                    <Border>
                      <Border.Background>
                        <LinearGradientBrush StartPoint="0,1" EndPoint="0,0">
                          <GradientStop Color="#CC080A0F" Offset="0"/>
                          <GradientStop Color="#00080A0F" Offset="0.85"/>
                        </LinearGradientBrush>
                      </Border.Background>
                    </Border>
                    <StackPanel VerticalAlignment="Bottom" Margin="14,0,14,9">
                      <TextBlock x:Name="HeroFxTxt" FontSize="14" FontWeight="SemiBold"
                                 Foreground="{StaticResource Text}"/>
                      <TextBlock x:Name="HeroSubTxt" Style="{StaticResource FaintTxt}" Margin="0,1,0,0"
                                 TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                  </Grid>
                </Border>
                <StackPanel Margin="15,12,15,13">
                  <TextBlock x:Name="EffectHdr" Style="{StaticResource SectionHdr}" Margin="0,0,0,10"/>
                  <!-- UniformGrid (not WrapPanel): 4 equal columns stretch to the card's right
                       edge, so the tile block lines up with the form rows below it -->
                  <UniformGrid x:Name="EffectChips" Columns="4"/>
                  <Border Height="1" Background="{StaticResource BorderSoft}" Margin="0,4,0,13"/>
                  <StackPanel x:Name="EffectParams"/>
                </StackPanel>
              </StackPanel>
            </Border>

          </StackPanel>
        </ScrollViewer>

        <!-- LEGACY: Lighting's per-device target selector was removed — Lighting is now
             GLOBAL only. The cards stay in the XAML (Collapsed) so MainWindow.Devices.cs
             still compiles; the Devices tab owns per-device/zone editing. Delete this
             block + BuildDeviceList() entirely once the new Devices-tab effect UI is in. -->
        <ScrollViewer Visibility="Collapsed"><StackPanel>
            <Border Visibility="Collapsed"><StackPanel>
                <TextBlock x:Name="TargetHdr" Visibility="Collapsed"/>
                <TextBlock x:Name="OverrideHint" Visibility="Collapsed"/>
                <StackPanel x:Name="DeviceList"/>
            </StackPanel></Border>
        </StackPanel></ScrollViewer>

        <!-- === DEVICES === -->
        <!-- Bottom padding clears the fixed action bar so the last card is never clipped. -->
        <ScrollViewer x:Name="PageDevices" VerticalScrollBarVisibility="Auto" Padding="6,10,10,18"
                      Visibility="Collapsed">
          <StackPanel>
            <!-- No page-level hint here: it duplicated the Zones card subtitle. Each card carries
                 its own one-line explanation instead. -->

            <!-- shown instead of the cards when nothing was detected: an empty state, not a
                 header with no rows -->
            <Border x:Name="DevEmptyCard" Style="{StaticResource CardBd}" Margin="0,0,0,10"
                    Visibility="Collapsed" Padding="18,22">
              <StackPanel HorizontalAlignment="Center">
                <TextBlock Text="&#xEA80;" FontFamily="Segoe MDL2 Assets" FontSize="26"
                           Foreground="{DynamicResource Faint}" HorizontalAlignment="Center"/>
                <TextBlock x:Name="DevEmptyTxt" Style="{StaticResource MutedTxt}" TextWrapping="Wrap"
                           TextAlignment="Center" Margin="0,12,0,14" MaxWidth="300"/>
                <Button x:Name="DevEmptyBtn" Style="{StaticResource Btn}" Click="Rescan_Click"
                        HorizontalAlignment="Center"/>
              </StackPanel>
            </Border>

            <Border x:Name="DevPickCard" Style="{StaticResource CardBd}" Margin="0,0,0,10">
              <StackPanel>
                <TextBlock x:Name="DevPickHdr" Style="{StaticResource SectionHdr}" Margin="0,0,0,10"/>
                <StackPanel x:Name="DevPickList"/>
              </StackPanel>
            </Border>

            <Border x:Name="ZoneCard" Style="{StaticResource CardBd}" Margin="0,0,0,10" Visibility="Collapsed">
              <StackPanel>
                <TextBlock x:Name="ZoneHdr" Style="{StaticResource SectionHdr}" Margin="0,0,0,4"/>
                <TextBlock x:Name="ZoneHint" Style="{StaticResource FaintTxt}" TextWrapping="Wrap" Margin="0,0,0,11"/>
                <StackPanel x:Name="ZoneList"/>
                <Button x:Name="ZoneApplyBtn" Style="{StaticResource Btn}" Click="ZoneApply_Click"
                        HorizontalAlignment="Left" Margin="0,4,0,0" FontSize="11"/>
              </StackPanel>
            </Border>

            <Border x:Name="CalCard" Style="{StaticResource CardBd}" Margin="0,0,0,10" Visibility="Collapsed">
              <StackPanel>
                <TextBlock x:Name="CalHdr" Style="{StaticResource SectionHdr}" Margin="0,0,0,4"/>
                <TextBlock x:Name="CalHint" Style="{StaticResource FaintTxt}" TextWrapping="Wrap" Margin="0,0,0,11"/>
                <StackPanel x:Name="CalPanel"/>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBd}" Margin="0,0,0,4">
              <Expander x:Name="HelpExp">
                <TextBlock x:Name="MissingTxt" Style="{StaticResource FaintTxt}" TextWrapping="Wrap"
                           Margin="2,8,0,2"/>
              </Expander>
            </Border>
          </StackPanel>
        </ScrollViewer>

        <!-- === HARDWARE === -->
        <!-- Device rows are built in code (MainWindow.Hardware.cs) because their count and reason
             text depend on the runtime USB scan; the setup + explanation cards below are static.
             The setup rows LIVE HERE ONLY — they used to sit in Settings > Advanced, where a
             first-run user never found the answer to "why is my RAM/mouse missing?". -->
        <ScrollViewer x:Name="PageHardware" VerticalScrollBarVisibility="Auto" Padding="6,4,10,18"
                      Visibility="Collapsed">
          <StackPanel>
            <StackPanel x:Name="HwList"/>

            <Border Style="{StaticResource CardBd}" Margin="0,0,0,10">
              <StackPanel>
                <TextBlock x:Name="AdvancedHdr" Style="{StaticResource SectionHdr}" Margin="0,0,0,9"/>
                <TextBlock x:Name="AdminTxt" Style="{StaticResource FaintTxt}" TextWrapping="Wrap"
                           Margin="0,0,0,11"/>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock x:Name="PawnIoTxt" Style="{StaticResource MutedTxt}" TextWrapping="Wrap"
                             VerticalAlignment="Center" Margin="0,0,14,0"/>
                  <Button x:Name="PawnIoBtn" Grid.Column="1" Style="{StaticResource Btn}"
                          Click="InstallPawnIo_Click" FontSize="11" VerticalAlignment="Center"/>
                </Grid>

                <!-- RGB RAM row: registers the engine as an elevated on-demand task, so the RAM
                     lights up while FullRGB itself keeps running as a normal user. -->
                <Grid Margin="0,11,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock x:Name="RamTxt" Style="{StaticResource MutedTxt}" TextWrapping="Wrap"
                             VerticalAlignment="Center" Margin="0,0,14,0"/>
                  <Button x:Name="RamBtn" Grid.Column="1" Style="{StaticResource Btn}"
                          Click="EngineTask_Click" FontSize="11" VerticalAlignment="Center"/>
                </Grid>
                <ProgressBar x:Name="DepBar" Style="{StaticResource Prog}" Minimum="0" Maximum="100"
                             Margin="0,11,0,0" Visibility="Collapsed"/>
                <TextBlock x:Name="DepTxt" Style="{StaticResource FaintTxt}" Margin="0,7,0,0"
                           TextWrapping="Wrap" Visibility="Collapsed"/>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBd}" Margin="0,0,0,10">
              <StackPanel>
                <TextBlock x:Name="WhyHdr" Style="{StaticResource SectionHdr}" Margin="0,0,0,9"/>
                <TextBlock x:Name="Why1Txt" Style="{StaticResource FaintTxt}" TextWrapping="Wrap"
                           Margin="0,0,0,7"/>
                <TextBlock x:Name="Why2Txt" Style="{StaticResource FaintTxt}" TextWrapping="Wrap"
                           Margin="0,0,0,7"/>
                <TextBlock x:Name="Why3Txt" Style="{StaticResource FaintTxt}" TextWrapping="Wrap"/>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>

        <!-- === SETTINGS === -->
        <!-- Bottom padding clears the fixed action bar so the last card is never clipped. -->
        <ScrollViewer x:Name="PageSettings" VerticalScrollBarVisibility="Auto" Padding="6,4,10,18"
                      Visibility="Collapsed">
          <StackPanel>
            <Border Style="{StaticResource CardBd}" Margin="0,0,0,10">
              <StackPanel>
                <TextBlock x:Name="ProfileHdr" Style="{StaticResource SectionHdr}" Margin="0,0,0,10"/>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <ComboBox x:Name="ProfileCmb" Grid.Column="0" Style="{StaticResource Cmb}"
                            SelectionChanged="ProfileCmb_SelectionChanged"/>
                  <Button x:Name="ProfileRenameBtn" Grid.Column="1" Style="{StaticResource IconBtn}"
                          Click="ProfileRename_Click" Content="&#xE70F;" Margin="6,0,0,0"/>
                  <Button x:Name="ProfileNewBtn" Grid.Column="2" Style="{StaticResource IconBtn}"
                          Click="ProfileNew_Click" Content="&#xE710;" Margin="6,0,0,0"/>
                  <Button x:Name="ProfileDelBtn" Grid.Column="3" Style="{StaticResource IconBtn}"
                          Click="ProfileDel_Click" Content="&#xE74D;" Margin="6,0,0,0"
                          Foreground="{StaticResource Danger}"/>
                </Grid>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBd}" Margin="0,0,0,10">
              <StackPanel>
                <TextBlock x:Name="AppearanceHdr" Style="{StaticResource SectionHdr}" Margin="0,0,0,10"/>
                <TextBlock x:Name="AccentLbl" Style="{StaticResource MutedTxt}" Margin="0,0,0,8"/>
                <WrapPanel x:Name="AccentSwatches"/>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBd}" Margin="0,0,0,10">
              <StackPanel>
                <TextBlock x:Name="StartupHdr" Style="{StaticResource SectionHdr}" Margin="0,0,0,11"/>
                <CheckBox x:Name="AutostartChk" Style="{StaticResource Chk}"
                          Checked="Autostart_Changed" Unchecked="Autostart_Changed"/>
                <CheckBox x:Name="MinimizedChk" Style="{StaticResource Chk}"
                          Checked="Minimized_Changed" Unchecked="Minimized_Changed"/>
                <CheckBox x:Name="AutoFxChk" Style="{StaticResource Chk}" Margin="0"
                          Checked="AutoFx_Changed" Unchecked="AutoFx_Changed"/>
                <CheckBox x:Name="CloseEngineChk" Style="{StaticResource Chk}" Margin="0,8,0,0"
                          Checked="CloseEngine_Changed" Unchecked="CloseEngine_Changed"/>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBd}" Margin="0,0,0,10">
              <StackPanel>
                <TextBlock x:Name="AboutHdr" Style="{StaticResource SectionHdr}" Margin="0,0,0,9"/>
                <TextBlock x:Name="AboutTxt" Style="{StaticResource FaintTxt}" TextWrapping="Wrap"/>
                <TextBlock x:Name="DiagTxt" Style="{StaticResource FaintTxt}" TextWrapping="Wrap"
                           Margin="0,9,0,0"/>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </Grid>

    <!-- ═════════ action bar ═════════ -->
    <Border Grid.Row="3" Background="{DynamicResource BgElevated}"
            BorderBrush="{DynamicResource BorderSoft}" BorderThickness="0,1,0,0" Padding="14,11">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Button x:Name="StopBtn" Grid.Column="0" Style="{StaticResource Btn}" Click="StopEffects_Click"/>
        <!-- "All off" is a peer action, so it gets real button chrome instead of bare text -->
        <Button x:Name="BlackoutBtn" Grid.Column="1" Style="{StaticResource Btn}"
                Foreground="{DynamicResource Muted}" Click="Blackout_Click" Margin="7,0,0,0"/>
        <Button x:Name="SaveBtn" Grid.Column="3" Style="{StaticResource AccentBtn}" Click="SaveProfile_Click"/>
      </Grid>
    </Border>
  </Grid>
</Window>
